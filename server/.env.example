# Use a hosted PostgreSQL connection string in Vercel.
# Neon and Supabase both provide one.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Paystack (https://paystack.com) - copy these from your Paystack Dashboard:
#   Settings -> API Keys & Webhooks -> Live/Test keys
# The PUBLIC key is used in the browser to open the Paystack popup.
# The SECRET key is used on the server to create and verify payments.
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
